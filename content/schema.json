{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taalpunt/content/schema.json",
  "title": "TaalPunt content bundle",
  "type": "object",
  "required": ["schema_version", "content_version", "units"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "content_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "language": { "type": "string" },
    "translation": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "title_en", "lessons", "vocabulary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "title_en": { "type": "string" },
          "color": { "enum": ["blue", "orange", "teal"] },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "title_en", "questions"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
                "title": { "type": "string" },
                "title_en": { "type": "string" },
                "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
              }
            }
          },
          "vocabulary": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nl", "en"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "nl": { "type": "string" },
                "en": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "explanation": {
      "type": ["object", "null"],
      "required": ["nl", "en"],
      "additionalProperties": false,
      "properties": { "nl": { "type": "string" }, "en": { "type": "string" } }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "answer"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+-\\d{2}$" },
        "type": { "enum": ["multiple_choice", "fill_blank", "true_false", "build_sentence"] },
        "prompt": { "type": "string" },
        "prompt_en": { "type": "string" },
        "answer": { "type": ["string", "boolean"] },
        "distractors": { "type": "array", "items": { "type": "string" } },
        "explanation": { "$ref": "#/$defs/explanation" }
      }
    }
  }
}
